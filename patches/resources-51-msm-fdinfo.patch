+#[cfg(test)]
+mod msm_fdinfo_tests {
+    use super::*;
+    use std::fs;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    fn fixture(fd: usize, client: &str, engine: &str, node: &str) -> Fdinfo {
+        Fdinfo {
+            pid: 42,
+            fdinfo_num: fd,
+            device_node: Some(PathBuf::from(node)),
+            content: parse_fdinfo(format!(
+                "drm-driver: msm\n\
+                 drm-client-id: {client}\n\
+                 drm-engine-gpu: {engine}\n\
+                 drm-total-memory: 51200 KiB\n"
+            )),
+        }
+    }
+
+    fn mock_sysfs() -> PathBuf {
+        let ts = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!("msm-fdinfo-{}-{ts}", std::process::id()));
+        // card0 would be DisplayLink EVDI on the real XPS.
+        fs::create_dir_all(root.join("card0")).unwrap();
+        fs::create_dir_all(root.join("card1")).unwrap();
+        fs::create_dir_all(root.join("renderD128/device/drm/card1")).unwrap();
+        root
+    }
+
+    #[test]
+    fn msm_fdinfo_maps_render_node_to_card1_not_evdi_card0() {
+        let root = mock_sysfs();
+        let sample = fixture(8, "12", "56000000000 ns", "/dev/dri/renderD128");
+        let (identifier, stats) = extract_gpu_usage_from_fdinfo_at(&sample, &root).unwrap();
+        assert_eq!(identifier, GpuIdentifier::Enumerator(1));
+        assert_eq!(
+            stats,
+            GpuUsageStats::MsmStats {
+                gfx_ns: 56_000_000_000,
+                client_fingerprint: msm_client_fingerprint(12),
+                client_count: 1,
+            }
+        );
+        assert_eq!(stats.mem(), None); // shared RAM is not dedicated VRAM
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn distinct_msm_clients_are_counted_once_each() {
+        let root = mock_sysfs();
+        let a = fixture(8, "12", "1000000 ns", "/dev/dri/renderD128");
+        let b = fixture(9, "13", "2500000 ns", "/dev/dri/renderD128");
+        // Two file handles to the same DRM client should not count twice.
+        let dup_a = fixture(10, "12", "1000000 ns", "/dev/dri/renderD128");
+        let mut skipped = HashSet::new();
+        let combined = other_gpu_usage_stats_at(&[a, b, dup_a], &mut skipped, &root);
+        assert!(skipped.is_empty());
+        assert_eq!(
+            combined.get(&GpuIdentifier::Enumerator(1)),
+            Some(&GpuUsageStats::MsmStats {
+                gfx_ns: 3_500_000,
+                client_fingerprint: msm_client_fingerprint(12) ^ msm_client_fingerprint(13),
+                client_count: 2,
+            })
+        );
+        assert!(!combined.contains_key(&GpuIdentifier::Enumerator(0)));
+        // read_dir/fdinfo can present DRM clients in arbitrary order;
+        // the identity must remain stable across permutations.
+        let reverse = other_gpu_usage_stats_at(
+            &[
+                fixture(9, "13", "2500000 ns", "/dev/dri/renderD128"),
+                fixture(8, "12", "1000000 ns", "/dev/dri/renderD128"),
+            ],
+            &mut HashSet::new(),
+            &root,
+        );
+        assert_eq!(combined, reverse);
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn client_dedup_preserves_distinct_ids_on_the_same_render_node() {
+        let a = fixture(8, "12", "100 ns", "/dev/dri/renderD128");
+        let b = fixture(9, "13", "200 ns", "/dev/dri/renderD128");
+        let dup_a = fixture(10, "12", "100 ns", "/dev/dri/renderD128");
+        let mut seen = HashSet::new();
+        assert!(seen.insert(drm_client_dedup_key(
+            a.device_node.as_deref().unwrap(),
+            &a.content
+        )));
+        assert!(seen.insert(drm_client_dedup_key(
+            b.device_node.as_deref().unwrap(),
+            &b.content
+        )));
+        assert!(!seen.insert(drm_client_dedup_key(
+            dup_a.device_node.as_deref().unwrap(),
+            &dup_a.content
+        )));
+    }
+
+    #[test]
+    fn malformed_msm_counters_are_never_converted_to_zero_usage() {
+        let root = mock_sysfs();
+        for (client, engine) in [
+            ("8", "wrong units"),
+            ("8", "100 ms"),
+            ("invalid", "0 ns"),
+            ("8", ""),
+            ("8", "18446744073709551616 ns"),
+        ] {
+            let sample = fixture(8, client, engine, "/dev/dri/renderD128");
+            assert!(
+                extract_gpu_usage_from_fdinfo_at(&sample, &root).is_err(),
+                "must reject {client} {engine}"
+            );
+        }
+        let mut missing = fixture(8, "8", "0 ns", "/dev/dri/renderD128");
+        missing.content.remove("drm-engine-gpu");
+        assert!(extract_gpu_usage_from_fdinfo_at(&missing, &root).is_err());
+        let valid_idle = fixture(8, "8", "0 ns", "/dev/dri/renderD128");
+        assert_eq!(
+            extract_gpu_usage_from_fdinfo_at(&valid_idle, &root)
+                .unwrap()
+                .1,
+            GpuUsageStats::MsmStats {
+                gfx_ns: 0,
+                client_fingerprint: msm_client_fingerprint(8),
+                client_count: 1,
+            }
+        );
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn unknown_or_ambiguous_gpu_must_not_get_a_guessed_id() {
+        let root = mock_sysfs();
+        let mut sample = fixture(8, "3", "10 ns", "/dev/dri/renderD129");
+        assert!(extract_gpu_usage_from_fdinfo_at(&sample, &root).is_err());
+        sample.device_node = None;
+        assert!(extract_gpu_usage_from_fdinfo_at(&sample, &root).is_err());
+        sample.device_node = Some(PathBuf::from("/dev/accel/accel0"));
+        assert!(extract_gpu_usage_from_fdinfo_at(&sample, &root).is_err());
+
+        fs::create_dir_all(root.join("renderD128/device/drm/card2")).unwrap();
+        let ambiguous = fixture(8, "3", "10 ns", "/dev/dri/renderD128");
+        assert!(extract_gpu_usage_from_fdinfo_at(&ambiguous, &root).is_err());
+        fs::remove_dir_all(root).unwrap();
+    }
+}
