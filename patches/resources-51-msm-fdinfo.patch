+/// Deterministic SplitMix64 fingerprint. Never exposed as a raw client ID.
+/// A count is recorded separately to distinguish client-set changes.
+fn msm_client_fingerprint(client_id: u64) -> u64 {
+    let mut v = client_id.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    v = (v ^ (v >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    v = (v ^ (v >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    v ^ (v >> 31)
+}
