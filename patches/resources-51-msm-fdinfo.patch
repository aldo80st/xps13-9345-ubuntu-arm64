+#[cfg(test)]
+mod msm_tests {
+    use super::GpuUsageStats;
+
+    #[test]
+    fn msm_delta_is_measured_only_with_valid_time_and_monotonic_counter() {
+        let old = GpuUsageStats::MsmStats {
+            gfx_ns: 100_000_000,
+            client_fingerprint: 17,
+            client_count: 1,
+        };
+        let current = GpuUsageStats::MsmStats {
+            gfx_ns: 150_000_000,
+            client_fingerprint: 17,
+            client_count: 1,
+        };
+        assert_eq!(current.gfx_fraction(&old, 1000), Some(0.05));
+        assert_eq!(current.gfx_fraction(&old, 0), None);
+        assert_eq!(old.gfx_fraction(&current, 1000), None);
+        assert_eq!(current.enc_fraction(&old, 1000), None);
+        assert_eq!(current.dec_fraction(&old, 1000), None);
+        assert_eq!(current.mem(), None);
+        let changed_client = GpuUsageStats::MsmStats {
+            gfx_ns: 200_000_000,
+            client_fingerprint: 18,
+            client_count: 1,
+        };
+        assert_eq!(changed_client.gfx_fraction(&old, 1000), None);
+        let new_client = GpuUsageStats::MsmStats {
+            gfx_ns: 200_000_000,
+            client_fingerprint: 17,
+            client_count: 2,
+        };
+        assert_eq!(new_client.gfx_fraction(&old, 1000), None);
+    }
+
+    #[test]
+    fn msm_duplicate_clients_merge_conservatively() {
+        let a = GpuUsageStats::MsmStats {
+            gfx_ns: 70,
+            client_fingerprint: 17,
+            client_count: 1,
+        };
+        let b = GpuUsageStats::MsmStats {
+            gfx_ns: 90,
+            client_fingerprint: 17,
+            client_count: 1,
+        };
+        assert_eq!(a.greater(&b), b);
+    }
+}
