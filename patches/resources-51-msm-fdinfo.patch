-fn extract_gpu_usage_from_fdinfo(fdinfo: &Fdinfo) -> Result<(GpuIdentifier, GpuUsageStats)> {
+// Qualcomm msm is a platform DRM driver, not PCI. The correct card number
+// comes from the render node's sysfs parent, not from Enumerator(0).
+// A machine may have several DisplayLink/EVDI card devices in front of Adreno.
+fn msm_gpu_identifier(fdinfo: &Fdinfo, sysfs_drm_root: &Path) -> Result<GpuIdentifier> {
+    let target = fdinfo
+        .device_node
+        .as_deref()
+        .ok_or_else(|| anyhow::anyhow!("MSM fdinfo has no DRM device-node provenance"))?;
+    if target.parent() != Some(Path::new("/dev/dri")) {
+        bail!("MSM fdinfo does not reference /dev/dri");
+    }
+    let name = target
+        .file_name()
+        .and_then(|s| s.to_str())
+        .unwrap_or_default();
+    let card_num = if let Some(number) = name.strip_prefix("card") {
+        let parsed = number.parse::<usize>()?;
+        if !sysfs_drm_root.join(name).exists() {
+            bail!("DRM card path not present in sysfs");
+        }
+        parsed
+    } else if name.starts_with("renderD") && name[7..].parse::<usize>().is_ok() {
+        let child_dir = sysfs_drm_root.join(name).join("device/drm");
+        let mut cards = std::fs::read_dir(child_dir)?.filter_map(|entry| {
+            entry
+                .ok()?
+                .file_name()
+                .to_str()?
+                .strip_prefix("card")?
+                .parse::<usize>()
+                .ok()
+        });
+        let card = cards
+            .next()
+            .ok_or_else(|| anyhow::anyhow!("render device has no DRM card"))?;
+        if cards.next().is_some() {
+            bail!("ambiguous DRM card for render device");
+        }
+        card
+    } else {
+        bail!("unsupported DRM node for msm");
+    };
+    Ok(GpuIdentifier::Enumerator(card_num))
+}
