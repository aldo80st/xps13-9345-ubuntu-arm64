From: XPS 13 ARM64 investigation <noreply@example.invalid>
Subject: [RFC PATCH v3] integrity: check shim MOKvar even without EFI runtime

This RFC is NOT approved for deployment. Use the shim-provided MOKvar
config table, but only if early EFI_SECURE_BOOT was set and explicit MokListTrustedRT authorization and a MOKx
revocation entry exist. Do not call EFI variables without runtime.
Abort MOK trust import if parsing MOKx fails.
Use get_handler_for_mok rather than get_handler_for_db for MokListRT.

SECURITY BLOCKERS BEFORE UPSTREAM OR DEPLOYMENT:
- The UEFI firmware dbx cannot be consulted with efi=noruntime.
  Review revocation guarantees and whether the MOKvar handoff provides
  adequate authenticated revocation state in this threat model.
- Confirm shim MOKvar provenance, bootloader trust, and firmware quirks.
- Upstream maintainer review and distribution-signed kernel required.
Do not deploy a self-signed replacement kernel in Secure Boot mode.

Source: Ubuntu 26.10 linux-source-7.3.0 7.3.0-10.10,
load_uefi.c SHA256 2abff60cd5d5fcbdd5dfde3da3ca38bd9a16dbb6b1b3b822c38596ac7128424d.

---
--- a/security/integrity/platform_certs/load_uefi.c
+++ b/security/integrity/platform_certs/load_uefi.c
@@ -120,7 +120,7 @@
 	efi_char16_t *efivar_name = L"MokListRT";
 	const char *parse_mokvar_name = "UEFI:MokListRT (MOKvar table)";
 	const char *parse_efivar_name = "UEFI:MokListRT";
-	efi_element_handler_t (*get_handler_for_guid)(const efi_guid_t *) = get_handler_for_db;
+	efi_element_handler_t (*get_handler_for_guid)(const efi_guid_t *) = get_handler_for_mok;
 
 	if (!load_db) {
 		mokvar_name = "MokListXRT";
@@ -148,6 +148,13 @@
 		       mokvar_name, rc);
 	}
 
+	/*
+	 * The shim MOKvar config table can be read without EFI runtime.
+	 * Do not call get_cert_list() when get_variable is disabled.
+	 */
+	if (!efi_rt_services_supported(EFI_RT_SUPPORTED_GET_VARIABLE))
+		return mokvar_entry ? rc : 0;
+
 	/* Get MokListRT. It might not exist, so it isn't an error
 	 * if we can't get it.
 	 */
@@ -189,8 +196,28 @@
 		return false;
 	}
 
-	if (!efi_rt_services_supported(EFI_RT_SUPPORTED_GET_VARIABLE))
-		return false;
+	/*
+	 * With EFI runtime disabled, only consider the shim MOKvar table if
+	 * the kernel EFI stub has already recorded Secure Boot as enabled.
+	 * Never trust the late runtime query alone on these platforms.
+	 *
+	 * Require the MOK revocation entry as well. In its absence, refuse
+	 * to import any positive MOK certificates without runtime services.
+	 * Firmware dbx cannot be queried on this path (security review).
+	 */
+	if (!efi_rt_services_supported(EFI_RT_SUPPORTED_GET_VARIABLE)) {
+		if (!efi_enabled(EFI_SECURE_BOOT))
+			return 0;
+		/*
+		 * Only honour positive MOK trust if shim explicitly provided its
+		 * MokListTrustedRT authorization in the early config table.
+		 */
+		if (!efi_mokvar_entry_find("MokListTrustedRT"))
+			return -EINVAL;
+		if (!efi_mokvar_entry_find("MokListXRT"))
+			return -EINVAL;
+		goto load_mok_table;
+	}
 
 	/* Get db and dbx.  They might not exist, so it isn't an error
 	 * if we can't get them.
@@ -231,10 +258,13 @@
 	if (!arch_get_secureboot())
 		return 0;
 
-	/* Load the MokListXRT certs */
+load_mok_table:
+	/* Process revocations first; failure must block positive MOK trust. */
 	rc = load_moklist_certs(false);
-	if (rc)
+	if (rc) {
 		pr_err("Couldn't parse mokx signatures: %d\n", rc);
+		return rc;
+	}
 
 	/* Load the MokListRT certs */
 	rc = load_moklist_certs(true);
