diff --git a/src/devices/gpu/qualcomm.rs b/src/devices/gpu/qualcomm.rs
new file mode 100644
index 0000000..cf33fbb
--- /dev/null
+++ b/src/devices/gpu/qualcomm.rs
@@ -0,0 +1,236 @@
+//! Read-only Qualcomm Adreno telemetry from upstream kernel interfaces.
+//! The DRM KMS driver may be msm_dpu while the GPU platform device is adreno.
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+use anyhow::{Context, Result, anyhow};
+
+#[derive(Debug)]
+pub(super) struct AdrenoTelemetry {
+    devfreq: PathBuf,
+    temperatures: Vec<PathBuf>,
+    name: &'static str,
+}
+
+impl AdrenoTelemetry {
+    pub fn host() -> Option<Self> {
+        Self::discover(
+            Path::new("/sys/bus/platform/drivers/adreno"),
+            Path::new("/sys/class/hwmon"),
+            Path::new("/sys/class/thermal"),
+        )
+    }
+
+    fn discover(drivers: &Path, hwmon: &Path, thermal: &Path) -> Option<Self> {
+        // Do not mistake a generic KMS (msm_dpu) device for a running GPU:
+        // the adreno platform driver must have an attached device with devfreq.
+        for entry in fs::read_dir(drivers).ok()?.flatten() {
+            let device = entry.path();
+            let Ok(compatible) = fs::read(device.join("of_node/compatible")) else {
+                continue;
+            };
+            if !compatible
+                .split(|byte| *byte == 0)
+                .any(|value| value.starts_with(b"qcom,adreno"))
+            {
+                continue;
+            }
+
+            let Ok(entries) = fs::read_dir(device.join("devfreq")) else {
+                continue;
+            };
+            let Some(devfreq) = entries
+                .flatten()
+                .map(|entry| entry.path())
+                .find(|path| path.join("cur_freq").is_file())
+            else {
+                continue;
+            };
+
+            let name = if compatible
+                .split(|byte| *byte == 0)
+                .any(|value| value == b"qcom,adreno-43050c01")
+            {
+                "Qualcomm Adreno X1-85"
+            } else {
+                "Qualcomm Adreno"
+            };
+
+            return Some(Self {
+                devfreq,
+                temperatures: find_gpu_sensors(hwmon, thermal),
+                name,
+            });
+        }
+        None
+    }
+
+    pub fn name(&self) -> &'static str {
+        self.name
+    }
+
+    /// Current GPU clock from devfreq, in Hz.
+    pub fn frequency_hz(&self) -> Result<f64> {
+        let hz = fs::read_to_string(self.devfreq.join("cur_freq"))
+            .context("cannot read Adreno devfreq cur_freq")?
+            .trim()
+            .parse::<u64>()?;
+        if hz == 0 {
+            return Err(anyhow!("GPU clock is zero or unavailable"));
+        }
+        Ok(hz as f64)
+    }
+
+    /// Hotspot among the readable GPU subsystem thermal sensors, in °C.
+    pub fn temperature_c(&self) -> Result<f64> {
+        self.temperatures
+            .iter()
+            .filter_map(|path| {
+                fs::read_to_string(path)
+                    .ok()?
+                    .trim()
+                    .parse::<f64>()
+                    .ok()
+                    .map(|value| value / 1000.0)
+                    .filter(|value| value.is_finite() && (-40.0..=150.0).contains(value))
+            })
+            .reduce(f64::max)
+            .ok_or_else(|| anyhow!("no readable Adreno thermal sensor"))
+    }
+}
+
+fn valid_gpu_sensor(name: &str) -> bool {
+    let rest = name
+        .strip_prefix("gpuss_")
+        .and_then(|value| value.strip_suffix("_thermal"))
+        .or_else(|| {
+            name.strip_prefix("gpuss-")
+                .and_then(|value| value.strip_suffix("-thermal"))
+        });
+    rest.is_some_and(|digits| !digits.is_empty() && digits.bytes().all(|b| b.is_ascii_digit()))
+}
+
+fn find_gpu_sensors(hwmon: &Path, thermal: &Path) -> Vec<PathBuf> {
+    let mut sensors = Vec::new();
+    if let Ok(entries) = fs::read_dir(hwmon) {
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let Ok(name) = fs::read_to_string(path.join("name")) else {
+                continue;
+            };
+            let input = path.join("temp1_input");
+            if valid_gpu_sensor(name.trim()) && input.is_file() {
+                sensors.push(input);
+            }
+        }
+    }
+
+    // Same hardware sensors may only exist in thermal_zone on some kernels.
+    if sensors.is_empty() {
+        if let Ok(entries) = fs::read_dir(thermal) {
+            for entry in entries.flatten() {
+                let path = entry.path();
+                let Ok(name) = fs::read_to_string(path.join("type")) else {
+                    continue;
+                };
+                let input = path.join("temp");
+                if valid_gpu_sensor(name.trim()) && input.is_file() {
+                    sensors.push(input);
+                }
+            }
+        }
+    }
+    sensors.sort();
+    sensors
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    #[test]
+    fn gpu_sensor_filter_does_not_accept_cpu_npu_or_memory() {
+        assert!(valid_gpu_sensor("gpuss_0_thermal"));
+        assert!(valid_gpu_sensor("gpuss_7_thermal"));
+        assert!(valid_gpu_sensor("gpuss-2-thermal"));
+        for name in [
+            "cpuss0_top_thermal",
+            "nsp0_thermal",
+            "gpu_thermal",
+            "gpuss_memory_thermal",
+            "gpuss_thermal",
+            "gpussZ_thermal",
+        ] {
+            assert!(!valid_gpu_sensor(name), "{name}");
+        }
+    }
+
+    #[test]
+    fn discovers_only_bound_adreno_and_reads_gpu_telemetry() {
+        let token = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root =
+            std::env::temp_dir().join(format!("resources-adreno-{}-{token}", std::process::id()));
+        let drivers = root.join("drivers");
+        let hwmon = root.join("hwmon");
+        let thermal = root.join("thermal");
+        let other = drivers.join("some-display");
+        fs::create_dir_all(other.join("devfreq/noop")).unwrap();
+        fs::create_dir_all(other.join("of_node")).unwrap();
+        fs::write(other.join("of_node/compatible"), b"qcom,x1e80100-dpu\0").unwrap();
+        fs::write(other.join("devfreq/noop/cur_freq"), "900000000").unwrap();
+
+        let adreno = drivers.join("3d00000.gpu");
+        fs::create_dir_all(adreno.join("of_node")).unwrap();
+        fs::create_dir_all(adreno.join("devfreq/3d00000.gpu")).unwrap();
+        fs::write(
+            adreno.join("of_node/compatible"),
+            b"qcom,adreno-43050c01\0qcom,adreno\0",
+        )
+        .unwrap();
+        fs::write(adreno.join("devfreq/3d00000.gpu/cur_freq"), "550000000\n").unwrap();
+        for (number, name, temp) in [
+            (0, "gpuss_0_thermal", "71000"),
+            (1, "gpuss_1_thermal", "73500"),
+            (2, "nsp0_thermal", "99000"),
+        ] {
+            let sensor = hwmon.join(format!("hwmon{number}"));
+            fs::create_dir_all(&sensor).unwrap();
+            fs::write(sensor.join("name"), name).unwrap();
+            fs::write(sensor.join("temp1_input"), temp).unwrap();
+        }
+
+        let found = AdrenoTelemetry::discover(&drivers, &hwmon, &thermal).unwrap();
+        assert_eq!(found.name(), "Qualcomm Adreno X1-85");
+        assert_eq!(found.frequency_hz().unwrap(), 550000000.0);
+        assert_eq!(found.temperature_c().unwrap(), 73.5);
+
+        fs::remove_dir_all(&hwmon).unwrap();
+        let zone = thermal.join("thermal_zone0");
+        fs::create_dir_all(&zone).unwrap();
+        fs::write(zone.join("type"), "gpuss-1-thermal").unwrap();
+        fs::write(zone.join("temp"), "60750").unwrap();
+        let fallback = AdrenoTelemetry::discover(&drivers, &hwmon, &thermal).unwrap();
+        assert_eq!(fallback.temperature_c().unwrap(), 60.75);
+        fs::remove_dir_all(&root).unwrap();
+    }
+
+    #[test]
+    fn no_adreno_driver_is_not_a_gpu_telemetry_source() {
+        let root =
+            std::env::temp_dir().join(format!("resources-absent-adreno-{}", std::process::id()));
+        assert!(
+            AdrenoTelemetry::discover(
+                &root.join("no-drivers"),
+                &root.join("hwmon"),
+                &root.join("thermal")
+            )
+            .is_none()
+        );
+    }
+}
