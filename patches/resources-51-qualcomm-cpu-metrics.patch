+fn is_qualcomm_cpu_sensor(name: &str) -> bool {
+    let Some(rest) = name.strip_prefix("cpuss") else {
+        return false;
+    };
+
+    [
+        "_top_thermal",
+        "_btm_thermal",
+        "-top-thermal",
+        "-btm-thermal",
+    ]
+    .iter()
+    .any(|suffix| {
+        rest.strip_suffix(suffix).is_some_and(|cluster| {
+            !cluster.is_empty() && cluster.bytes().all(|b| b.is_ascii_digit())
+        })
+    })
+}
+
+fn search_for_qualcomm_cpu_temps(hwmon_root: &Path, thermal_root: &Path) -> Vec<PathBuf> {
+    let mut paths: Vec<PathBuf> = glob(&format!("{}/hwmon*", hwmon_root.display()))
+        .unwrap()
+        .flatten()
+        .filter_map(|path| {
+            let name = read_parsed::<String>(path.join("name")).ok()?;
+            is_qualcomm_cpu_sensor(name.trim())
+                .then(|| search_for_cpu_temp(path.to_string_lossy()))
+                .flatten()
+        })
+        .collect();
+
+    // Some kernels expose CPU cluster temperatures only through thermal zones.
+    if paths.is_empty() {
+        paths = glob(&format!("{}/thermal_zone*", thermal_root.display()))
+            .unwrap()
+            .flatten()
+            .filter_map(|path| {
+                let name = read_parsed::<String>(path.join("type")).ok()?;
+                let temp = path.join("temp");
+                (is_qualcomm_cpu_sensor(name.trim()) && temp.exists()).then_some(temp)
+            })
+            .collect();
+    }
+
+    paths.sort();
+    paths
+}
